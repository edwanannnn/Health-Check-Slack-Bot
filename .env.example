# ─── Slack Credentials ───────────────────────────────────────
# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-YOUR-BOT-TOKEN

# App-Level Token for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=xapp-YOUR-APP-TOKEN

# Signing Secret (hex string from Basic Information page)
SLACK_SIGNING_SECRET=YOUR_SIGNING_SECRET

# Channel ID to send automated alerts to
SLACK_ALERT_CHANNEL=C0BELBY2F3R

# ─── TensorNex API ───────────────────────────────────────────
# Base URL of the TensorNex GPU server
TENSORNEX_BASE_URL=http://YOUR_SERVER_IP:8000

# Internal API key (same as INTERNAL_API_KEY on the GPU server)
TENSORNEX_API_KEY=your-internal-api-key

# ─── Schedule ────────────────────────────────────────────────
# How often to check (minutes). Only alerts on state CHANGE.
CHECK_INTERVAL_MINUTES=5

# HTTP timeout for health-check requests (seconds)
REQUEST_TIMEOUT=30
